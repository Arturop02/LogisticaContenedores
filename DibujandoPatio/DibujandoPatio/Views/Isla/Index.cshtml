@using BT.Patio

@model List<BT.Patio.IslaBT>
@{
    ViewBag.Title = "Islas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patios = ViewBag.Patios as List<PatioBT>;
}

<div id="contenedorKonva" class="mb-3">
    <button id="crearIsla" class="btn btn-primary">Agregar Isla</button>
    <button id="guardarIsla" class="btn btn-success d-none">Guardar Isla</button>
    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-primary">Tamaño Original</button>
</div>
<br />

<ul class="nav nav-tabs" id="patioTabs" role="tablist">
    @for (int i = 0; i < patios.Count; i++)
    {
        var p = patios[i];
        <li class="nav-item" role="presentation">
            <button class="nav-link btn btn-primary"
                    type="button"
                    role="tab"
                    aria-selected="@(i==0 ? "true" : "false")"
                    data-id="@p.Id"
                    data-escala="@p.Escala">
                @p.Nombre
            </button>
        </li>
    }
</ul>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-12 col-md-10 mx-auto">
            <div id="container" style="width: 100%; height: 80vh; box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/Patio/Patio.js"></script>

    <script src="~/Scripts/Isla/Isla.js"></script>

    <script>
        var idPatioSeleccionado = '@ViewBag.IdPatioSeleccionado';
    </script>

    <script>
        $(document).ready(function () {
            inicializarPatio();
        });
    </script>
}