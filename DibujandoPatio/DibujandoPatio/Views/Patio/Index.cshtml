@using BT.Patio
@model List<BT.Patio.PatioBT>
@*@model DibujandoPatio.Models.PatioLayout*@
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patios = ViewBag.Patios as List<PatioBT>;
}



<div class="mb-3 hidden">
    <input type="text" id="nombreInput" placeholder="Ingresa el nombre del patio" />
</div>

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }
</style>
<div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; ">
    <div id="lstAreas" class="btn-group" data-toggle="buttons">
        @{
            int i = 0;
        }

        @foreach (var p in patios)
        {
            <label class="btn btn-primary @(i==0 ? "active" : "")">
                <input type="radio"
                       name="area"
                       id="Area_@(p.Id)"
                       data-id="@p.Id"
                       data-escala="@p.Escala"
                       autocomplete="off"
                       @(i == 0 ? "checked" : "")> @p.Nombre
                </label>
                i++;
            }

    </div>
    <button id="guardarBtn" class="btn btn-success pull-right" disabled>Guardar</button>
    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-fullscreen" aria-hidden="true"></i></button>
</div>
<div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>


@section scripts{
    <script>
        $(document).ready(function () {
            inicializarPatio();
        });
    </script>
    <script src="~/Scripts/Patio/Patio.js"></script>
}
