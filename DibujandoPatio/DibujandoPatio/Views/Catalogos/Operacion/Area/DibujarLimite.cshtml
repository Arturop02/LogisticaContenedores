@using BT.Patio
@model List<BT.AreaBT>
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
    var patios = ViewBag.Patios as List<PatioBT>;
}

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }
</style>
<div id="app">
    <div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000;">
        <div id="lstAreas" class="btn-group">
            @foreach (var a in areas)
            {
                <label class="btn btn-primary"
                       :class="{active: areaId == @a.Id}"
                       v-on:click="seleccionarArea(@a.Id,'@a.Nombre')"
                       autocomplete="off">
                    @a.Nombre
                </label>
            }
        </div>
        <button class="btn btn-success pull-right"
                :disabled="!puedeGuardar"
                v-on:click="guardar">
            <i class="glyphicon glyphicon-ok"></i>Guardar
        </button>
        <button class="btn btn-warning"
                :disabled="!areaSeleccionada"
                v-on:click="agregarZona">
            <i class="glyphicon glyphicon-pencil"></i>Agregar Zona
        </button>
        <button class="btn btn-default"
                v-on:click="nuevoEnu">
            <i class="glyphicon glyphicon-plus"></i>Nuevo Enu
        </button>
        <button class="btn btn-success"
                v-on:click="iniciarDibujo">
            <i class="glyphicon glyphicon-plus" aria-hidden="true"></i>
        </button>
        <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-resize-full" aria-hidden="true"></i></button>
        <button onclick="Lienzo.PantallaCompleta()" class="btn btn-warning"><i class="glyphicon glyphicon-fullscreen" aria-hidden="true"></i></button>

    </div>
    <div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>

    <div id="modalGuardado" v-show="mostrarModalArea" class="mi-modal-overlay" style="display:none">
        <div class="mi-modal">
            <label for="selectPatio">Selecciona el patio:</label>
            <select @*v-model="nuevaArea.patioId"*@ id="selectPatio" class="form-control">
                <option value="">-- Selecciona --</option>
                @foreach (var p in patios)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
            <label class="mt-2">Nombre del area::</label>
            <input @*v-model="nuevaArea.nombre"*@ id="nombreArea" type="text" class="form-control" placeholder="Ingresa el nombre del área nueva" />
        </div>
    </div>
</div>

