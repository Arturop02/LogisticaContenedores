@using BT.Patio
@model List<BT.Patio.PatioBT>
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patios = ViewBag.Patios as List<PatioBT>;
}

<div class="mb-3 hidden">
    <input type="text" id="nombreInput" placeholder="Ingresa el nombre del patio" />
</div>

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    .grid-previews {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        padding: 20px;
    }

        .grid-previews a {
            display: block;
            text-decoration: none;
            color: inherit;
        }

    .preview-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fafafa;
        box-shadow: 0 2px 6px rgba(0,0,0,.1);
        cursor: pointer;
        overflow: hidden;
        display: block;
        position: relative;
    }
        .preview-card :hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.25);
        }

    .preview-header {
        padding: 10px;
        font-weight: bold;
        background: #337AB7;
        color: #fff;
        border-bottom: 1px solid #ddd;
        display: flex;
        align-content: center;
        justify-content: center;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .preview-canvas {
        height: 220px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .preview-overlay {
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
        height: 60px;
        background: rgba(0,0,0,0.65);
        display: flex !important;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 15px;
        transform: translateY(-100%);
        opacity: 0;
        transition: transform 0.25s ease, opacity 0.25s ease;
        z-index: 10;
    }

        .preview-overlay.show {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .preview-overlay button {
            padding: 10px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            background: #449d44;
            font-weight: bold;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            min-width: 120px;
            color: #fff;
            font-size: 14px;
            flex-shrink: 0;
        }

            .preview-overlay button:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.25);
            }

    body > nav.navbar {
        display: none;
    }
</style>
<div id="app">
    <div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; ">
        <div id="lstPatios" class="btn-group">

            @foreach (var p in patios)
            {
                <a href="@Url.Action("Index", new {Id =p.Id})">
                    <label class="btn btn-primary"
                           :class="{active: Patio?.Id == @p.Id}"
                           >
                        @p.Nombre
                    </label>
                </a>
            }
        </div>

        <button class="btn btn-success" v-on:click="agregarArea">
            <i class="glyphicon glyphicon-plus"></i>Agregar Nueva Area
        </button>

    </div>

    <div v-if="mostrar" id="previews-container" style="width: 100vw; padding: 30px; position: fixed; z-index: 9">
        <div id="lstAreasGrid" class="grid-previews">
            <div v-for="a in areas" :key="a.Id">
                <label class="preview-header">{{a.Nombre}}</label>
                <div class="preview-card" v-on:click.stop="areaOpcion = a.Id">
                    <div class="preview-canvas" :id="`preview-${a.Id}`"></div>
                    
                    <div class="preview-overlay" :class="{show: areaOpcion === a.Id}">
                        <button type="button" v-on:click.stop="redireccion('DibujarLimite', a.Id)">
                            Editar Areas
                        </button>
                        <button type="button" v-on:click.stop="redireccion('DibujarIsla', a.Id)">
                            Editar Zonas
                        </button>
                    </div>
                </div>
            </div>

            <!--<a v-for="a in areas" :key="a.Id" :href="`/Area/DibujarLimite?Id=${a.Id}`">
                <label :class="`preview-header-${a.Id}`">
                    {{a.Nombre}}
                </label>

                <div class="preview-card" :id="`preview-card-${a.Id}`">
                    <div class="preview-canvas" :id="`preview-${a.Id}`"></div>-->
                        @*<div class="preview-overlay" v-if="areaOpcion === ${a.Id}">
                        <label v-on:click="redireccion('DibujarLimite', ${a.Id})">Editar Area</label>
                        <label v-on:click="redireccion('DibujarIsla', ${a.Id})">Editar Zonas</label>
                    </div>*@

                <!--</div>

            </a>-->
        </div>
    </div>
</div>
<div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>


@section scripts{
    @Scripts.Render("~/bundles/vue")
    @Scripts.Render("~/bundles/konva")
    @Scripts.Render("~/bundles/linq")
    @Styles.Render("~/bundles/bootstrapselectcss")
    @Styles.Render("~/bundles/jqgridcss")
    @Scripts.Render("~/bundles/jqgrid")
    @Scripts.Render("~/bundles/bootstrapselect")
    @Styles.Render("~/bundles/fontawesomecss")
    @Scripts.Render("~/bundles/notify")
    <script src="~/Scripts/Patio/Patio.js"></script>
    <script src="~/Scripts/Area/Area.js"></script>
    <script>
        var objSer = {
            Url: {
                Patio: {
                    Index: '@Url.Action("Index", "Patio", new { Id = "__id__" })'
                },
                Isla: {
                    Index: '@Url.Action("Index", "Isla", new { id = "__id__" })',
                },
                Area: {
                    DibujarLimite: '@Url.Action("DibujarLimite", "Area", new {id="__id__"})',
                },
            },
            Dato: {
                PatioSeleccionado:@(ViewBag.PatioSeleccionado == null?"null": Html.Raw(ViewBag.PatioSeleccionado))
            },
        };
        $(document).ready(function () {
            if (objSer.Dato.PatioSeleccionado != null)
                vuePatio.Patio = objSer.Dato.PatioSeleccionado;
        });
    </script>

    <script>
        var vuePatio = new Vue({
            el: '#app',
            data() {
                return {
                    Patio: null,
                    Area: null,
                    mostrar: false,
                    areas: [],
                    areaOpcion: null,
                }
            },
            watch: {
                Patio: {
                    handler(newValue, oldValue) {
                        if (newValue != null) {
                            this.mostrar = true;
                            seleccionarPatio(newValue.Id);
                        }
                    },
                    deep: true
                },
                Area: {
                    handler(newValue, oldValue) {
                        if (newValue != null)
                            seleccionarArea(newValue.Id, newValue.Nombre);
                    },
                    deep: true
                },
            },
            methods: {
                seleccionarPatio(id, nombre) {
                    this.Patio.Id = id;
                    this.Patio.Nombre = nombre;
                    window.seleccionarPatio(this.Patio.Id);
                },
                seleccionarArea(id, nombre) {
                    this.areaId = id;
                    this.areaNombre = nombre;

                    window.seleccionarArea(id);
                },
                redireccion(accion, id) {
                    window.location.href = `/Area/${accion}/?id=${id}`;
                },
                agregarArea() {
                    window.nuevaArea();
                }
            },
            computed: {
                PatioSeleccionado() {
                    return this.Patio.Nombre ? `Patio: ${this.Patio.Nombre}` : `Sin seleccion`;
                }
            },
        });
    </script>
}
