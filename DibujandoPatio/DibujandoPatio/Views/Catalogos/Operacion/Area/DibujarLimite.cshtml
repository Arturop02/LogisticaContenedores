@using BT.Patio
@model List<BT.AreaBT>
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
    var patios = ViewBag.Patios as List<PatioBT>;
}

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }

    #notifications {
        cursor: pointer;
        position: fixed;
        top: 20px;
        left: 40vw;
        z-index: 9999;
        text-align: center;
        margin-bottom: 22px;
        margin-right: 15px;
        max-width: 300px;
    }

    /*font-face {
        font-family: "FontIconos";
        src: url('/Content/fontawesome-webfont.woff2')format('truetype');
    }*/

</style>
<div id="app">
    <div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000;">
        <div id="lstAreas" class="btn-group">
            @foreach (var a in areas)
            {
                <a href="@Url.Action("DibujarLimite",new {Id=a.Id})">
                    <label class="btn btn-primary"
                           :class="{active: Area?.Id == @a.Id}">
                        @a.Nombre
                    </label>
                </a>
            }
        </div>
        <button class="btn btn-success"
                v-on:click="iniciarDibujo">
            <i class="glyphicon glyphicon-plus" aria-hidden="true"></i>Nueva Area
        </button>
        <button class="btn btn-success pull-right"
                v-on:click="guardar">
            <i class="glyphicon glyphicon-ok"></i>Guardar
        </button>
        <button class="btn btn-warning"
                v-on:click="agregarZona">
            <i class="glyphicon glyphicon-pencil"></i>Agregar Zona
        </button>
        <button class="btn btn-default"
                v-on:click="nuevoEnu">
            <i class="glyphicon glyphicon-plus"></i>Nuevo Enu
        </button>
        <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-resize-full" aria-hidden="true"></i></button>
        <button onclick="Lienzo.PantallaCompleta()" class="btn btn-warning"><i class="glyphicon glyphicon-fullscreen" aria-hidden="true"></i></button>

    </div>
    <div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>

    <div id="modalGuardado" v-show="mostrarModalArea" class="mi-modal-overlay" style="display:none">
        <div class="mi-modal">
            <label for="selectPatio">Selecciona el patio:</label>
            <select id="selectPatio" class="form-control">
                <option value="">-- Selecciona --</option>
                @foreach (var p in patios)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
            <label class="mt-2">Nombre del area::</label>
            <input id="nombreArea" type="text" class="form-control" placeholder="Ingresa el nombre del área nueva" />
        </div>
    </div>

    <div id="notifications"></div>

    <div id="formEnu" class="mb-3" style="display:none">
        <label for="nuevoEnu">Nuevo ENU:</label>
        <input type="text" id="nuevoEnu" class="form-control" placeholder="Ingresa el nombre del nuevo ENU" />
    </div>

</div>


@section scripts{
    <script src="~/Scripts/Area/Area.js"></script>
    @Scripts.Render("~/bundles/vue")
    @Scripts.Render("~/bundles/konva")
    @Scripts.Render("~/bundles/linq")
    @Styles.Render("~/bundles/jqgridcss")
    @Scripts.Render("~/bundles/jqgrid")
    @Styles.Render("~/bundles/fontawesomecss")
    @Scripts.Render("~/bundles/notify")

    <script>
        var objSer = {
            Url: {
                Isla: {
                    Index: '@Url.Action("Index", "Isla", new { id = ""})',
                },
                Area: {
                    ObtenerAreaPorId: '@Url.Action("Index", "Area", new { id = "" })',
                    DibujarIsla: '@Url.Action("DibujarIsla", "Area", new {id="__id__"})',
                    DibujarLimite: '@Url.Action("DibujarLimite", "Area", new {id="__id__"})',
                },
            },
            Dato: {
                AreaSeleccionada:@(ViewBag.AreaSeleccionada==null?"null": Html.Raw(ViewBag.AreaSeleccionada))
            },
        };
    $(document).ready(function () {
        inicializarArea();

        if (objSer.Dato.AreaSeleccionada != null)
            vueArea.Area = objSer.Dato.AreaSeleccionada;
    });
    </script>
    <script>
        async function MensajeAsync(configuracion) {
            return new Promise((resolve, reject) => {
                var buttons = {};

                configuracion.Boton.forEach((item, index) => {
                    buttons['btn_' + index] = {
                        label: item.Etiqueta || '',
                        className: item.Clase || '',
                        callback: function () {
                            resolve(item);
                        }
                    }
                });

                bootbox.dialog({
                    title: configuracion.Titulo || '',
                    message: configuracion.Cuerpo || '',
                    size: 'large',
                    buttons: buttons
                });
            });
        }

        var vueArea= new Vue({
            el: '#app',
            data() {
                return {
                    mostrarModalArea: false,
                    dibujando: false,
                    Area: null
                }
            },
            watch: {
                Area: {
                    handler(newValue, oldValue) {
                        if (newValue != null)
                            seleccionarArea(newValue.Id, newValue.Nombre);
                    },
                    deep: true
                }
            },
            methods: {
                seleccionarArea(id,nombre) {
                    this.areaId = id;
                    this.areaNombre = nombre;

                    window.seleccionarArea(id);
                },
                agregarZona() {
                    window.agregarZona();
                },
                iniciarDibujo() {
                    this.Area = {
                        Id: 0,
                        Nombre: ''
                    };

                    window.iniciarDibujo();
                },
                async PreguntarConfirmacionGuardarAsync() {

                    var contenido = document.getElementById("modalGuardado").cloneNode(true);
                    contenido.style.display = "block";

                    var pregunta = await MensajeAsync({
                        Titulo: 'Confirmar guardado',
                        Cuerpo: contenido,
                        Boton: [
                            { Etiqueta: 'Cancelar', Clase: 'btn-danger', Valor: false },
                            { Etiqueta: 'Guardar', Clase: 'btn-success', Valor: true },
                        ],
                    });

                    if (pregunta.Valor === false) {
                        return { Confirmado: false };
                    }

                    const modal = $('.bootbox-body');

                    const idPatio = modal.find('#selectPatio').val();
                    const nombreArea = modal.find('#nombreArea').val().trim();

                    return ({ Confirmado: true, IdPatio: idPatio, NombreArea: nombreArea });
                },
                async nuevoEnu() {
                    var contenido = document.getElementById("formEnu").cloneNode(true);
                    contenido.style.display = "block";

                    var respuesta = await MensajeAsync({
                        Titulo: "Agregar Enum",
                        Cuerpo: contenido,
                        Boton: [
                            { Etiqueta: 'Cancelar', Clase: 'btn-danger', Valor: false },
                            { Etiqueta: 'Agregar', Clase: 'btn-success', Valor: true },
                        ],
                    });

                    if (respuesta.Valor === false) {
                        return;
                    }

                    const modal = $('.bootbox-body');
                    var DescripcionEnu = modal.find('#nuevoEnu').val().trim();

                    window.agregarEnu(DescripcionEnu);
                },
               async guardar() {
                   if (this.Area?.Id > 0) {
                       await window.guardarAsync(this.Area);
                   }
                   else {
                       try {
                           var preguntar = await this.PreguntarConfirmacionGuardarAsync();

                           if (preguntar.Confirmado) {
                               this.Area.Patio = { Id: preguntar.IdPatio };
                               this.Area.Nombre = preguntar.NombreArea;
                               this.Area = await window.guardarAsync(this.Area);
                               document.location.href = '@Url.Action("DibujarLimite",new {Id="__id__"})'.replace('__id__', this.Area.Id);
                           }
                       } catch (e) {
                           console.log(e);
                       }
                   }
               },
            },
            computed: {
                areaSeleccionada() {
                    return this.areaNombre ? `Area: ${this.areaNombre}` : `Sin seleccion`;
                }
            }
        });
    </script>
}
