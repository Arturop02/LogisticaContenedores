@using BT.Patio

@model List<BT.Patio.IslaBT>
@{
    ViewBag.Title = "Islas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
}

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }
</style>
<div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; ">
    <div id="lstAreas" class="btn-group" data-toggle="buttons">
        @{
            int i = 0;
        }

        @foreach (var a in areas)
        {
            <label class="btn btn-primary @(i==0 ? "active" : "")">
                <input type="radio"
                       name="area"
                       id="Area_@(a.Id)"
                       data-id="@a.Id"
                       @*data-escala="@p.Escala"*@
                       autocomplete="off"
                       @(i == 0 ? "checked" : "")> @a.Nombre
                </label>
                i++;
            }

    </div>
    <button id="guardarBtn" class="btn btn-success pull-right" disabled><i class="glyphicon glyphicon-ok"></i> Guardar</button>
    <button id="crearIsla" class="btn btn-warning" disabled><i class="glyphicon glyphicon-pencil"></i>Agregar Isla</button>

    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-fullscreen" aria-hidden="true"></i></button>
</div>
<div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>

@*<ul class="nav nav-tabs" id="patioTabs" role="tablist">
        @for (int i = 0; i < patios.Count; i++)
        {
            var p = patios[i];
            <li class="nav-item" role="presentation">
                <button class="nav-link btn btn-primary"
                        type="button"
                        role="tab"
                        aria-selected="@(i==0 ? "true" : "false")"
                        data-id="@p.Id"
                        data-escala="@p.Escala">
                    @p.Nombre
                </button>
            </li>
        }
    </ul>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-lg-12 col-md-10 mx-auto">
                <div id="container" style="width: 100%; height: 80vh; box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>
            </div>
        </div>
    </div>*@

@section scripts{
    
    <script src="~/Scripts/Isla/Isla.js"></script>

    <script src="~/Scripts/Area/Area.js"></script>

    <script>
        var idPatioSeleccionado = '@ViewBag.IdAreaSeleccionada';
    </script>

    <script>
        $(document).ready(function () {
            inicializarArea();
        });
    </script>

}