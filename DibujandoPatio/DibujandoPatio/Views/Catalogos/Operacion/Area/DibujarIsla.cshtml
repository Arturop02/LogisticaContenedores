@using BT.Patio

@model List<BT.Patio.IslaBT>
@{
    ViewBag.Title = "Islas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
    var enus = ViewBag.Enus as List<BT.Patio.DetalleEnuBT>;
    var estructuras = ViewBag.Estructuras as List<BT.Patio.EstructuraBT>;
}


<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }

    #notifications {
        cursor: pointer;
        position: fixed;
        top: 20px;
        left: 40vw;
        z-index: 9999;
        text-align: center;
        margin-bottom: 22px;
        margin-right: 15px;
        max-width: 300px;
    }

    .sidebar {
        position: fixed;
        top: 0;
        padding: 0px;
        right: -400px;
        width: 400px;
        height: 100vh;
        transition: right 0.3s ease;
        overflow: hidden;
        z-index: 1000;
        background-color: #f4f4f4;
        flex-direction: column;
    }

    .sidebar-header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

    .sidebar-content {
        flex: 1;
        overflow: auto;
        padding: 10px;
    }

    .sidebar.active {
        right: 0;
    }
</style>

<div id="app">
    <div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000;">
        <div id="lstAreas" class="btn-group">
            @foreach (var a in areas)
            {
                <a href="@Url.Action("DibujarIsla", new {Id=a.Id})">
                    <label class="btn btn-primary"
                           :class="{active: Area.Id == @a.Id}">
                        @a.Nombre
                    </label>
                </a>

            }
        </div>
        <button class="btn btn-success pull-right"
                v-on:click="guardarTodo">
            <i class="glyphicon glyphicon-ok"></i>Guardar
        </button>
        <button id="crearZona"
                class="btn btn-success"
                v-on:click="ConfirmacionCrearAsync">
            <i class="glyphicon glyphicon-plus"></i>Crear Zona
        </button>
        <button class="btn btn-warning"
                id="agregarTipoEstructura"
                v-on:click="agregarEstructura">
            <i class="glyphicon glyphicon-plus"></i>Nuevo Tipo Estructura
        </button>
        <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-resize-full" aria-hidden="true"></i></button>
        <button onclick="Lienzo.PantallaCompleta()" class="btn btn-warning"><i class="glyphicon glyphicon-fullscreen" aria-hidden="true"></i></button>

    </div>
    
    <div id="notifications"></div>

    <div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>
    <div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; display: none;">
        <div id="formularioEstructuras" class="form-group">
            <label>Descripcion</label>
            <input type="text" class="form-control" id="descripcionEstructura" required />
            <br />
            <label>Seleccionar Enu</label>
            <select id="enuEstructura" class="form-control" required>
                <option value="">Selecciona</option>
                @foreach (var e in enus)
                {
                    <option value="@e.Id">@e.Descripcion</option>
                }
            </select>
            <br />

            <label>Color</label>
            <input type="color" class="form-control" id="colorEstructura" value="#ff0000" required />
            <br />

            <label>Icono</label>
            <div>
                <input type="text" id="filtroIcono" placeholder="Icono" v-model="Paginado.filtroIcono" />
                <button type="button" class="btn btn-default" id="btnBuscarIconos">Buscar</button>
            </div>
            <div id="iconosContainer" class="btn-group" role="group" style="flex-wrap: wrap;"></div>
            <div id="paginador" class="mt-2"></div>
            <input type="hidden" id="iconoSeleccionado" />
        </div>
    </div>

    <div id="formZona" display="none">
        <form id="formIsla">
            <div class="form-group">
                <label>Nombre de la Zona</label>
                <input type="text" class="form-control" id="nombreIsla" required />
                <br />

                <label>Tipo de estructura</label>
                <select id="tipoEstructura" class="form-control" required>
                    <option value="">--Selecciona--</option>
                    @foreach (var e in estructuras)
                    {
                        <option value="@e.Id">@e.Descripcion</option>
                    }
                </select>
                <br />

                <label>Observaciones</label>
                <input type="text" class="form-control" id="observacionesIsla" />
            </div>
        </form>
    </div>

</div>
@section scripts{
    <script src="~/Scripts/Isla/Isla.js"></script>
    @Scripts.Render("~/bundles/vue")
    @Scripts.Render("~/bundles/konva")
    @Scripts.Render("~/bundles/linq")
    @Styles.Render("~/bundles/bootstrapselectcss")
    @Styles.Render("~/bundles/jqgridcss")
    @Scripts.Render("~/bundles/jqgrid")
    @Scripts.Render("~/bundles/bootstrapselect")
    @Styles.Render("~/bundles/fontawesomecss")
    @Scripts.Render("~/bundles/notify")

    <script>
    var objSer = {
        Url: {
            Isla: {
                Index: '@Url.Action("Index", "Isla", new { id = ""})',
            },
            Area: {
                DibujarIsla: '@Url.Action("DibujarIsla", "Area", new {id="__id__"})',
            },
        },
        Dato: {
            AreaSeleccionada:@(ViewBag.AreaSeleccionada==null?"null": Html.Raw(ViewBag.AreaSeleccionada))
        },
    };

    $(document).ready(function () {
        inicializarArea();

        if (objSer.Dato.AreaSeleccionada != null)
            vueIsla.Area = objSer.Dato.AreaSeleccionada;
    });

    </script>


    <script>
        async function MensajeAsync(configuracion) {
            return new Promise((resolve, reject) => {
                var buttons = {};

                configuracion.Boton.forEach((item, index) => {
                    buttons['btn_' + index] = {
                        label: item.Etiqueta || '',
                        className: item.Clase || '',
                        callback: function () {
                            resolve(item);
                        }
                    }
                });

                bootbox.dialog({
                    title: configuracion.Titulo || '',
                    message: configuracion.Cuerpo || '',
                    size: 'large',
                    buttons: buttons
                });
            });
        }

        var vueIsla = new Vue({
            el: '#app',
            data() {
                return {
                    Area: {
                        Id: 0,
                        Nombre: '',
                    },
                    Isla: {
                        Confirmado: false,
                        Nombre: "",
                        IdEstructura: null,
                        Observaciones: "",
                    },
                    iconos: [],
                    Paginado: {
                        filtroIcono: '',
                        iconoSeleccionado: ''
                    },
                }
            },
            watch: {
                Area: {
                    handler(newValue, oldValue) {
                        if (newValue != null)
                            seleccionarArea(newValue.Id, newValue.Nombre);
                    },
                    deep: true
                }
            },
            methods: {
                seleccionarArea(id, nombre) {
                    this.Area.Id = id;
                    this.Area.Nombre = nombre;

                    window.seleccionarArea(id, nombre);
                },
                async ConfirmacionCrearAsync() {
                    if (!this.Area.Id) {
                        bootbox.alert("Por favor, seleccione un patio");
                        return;
                    }

                    var formZona = document.getElementById("formZona").cloneNode(true);
                    formZona.style.display = "block";

                    var respuesta = await MensajeAsync({
                        Titulo: 'Crear zona',
                        Cuerpo: formZona,
                        Boton: [
                            { Etiqueta: 'Cancelar', Clase: 'btn-danger', Valor: false },
                            { Etiqueta: 'Confirmar', Clase: 'btn-success', Valor: true }
                        ],
                    });

                    if (respuesta.Valor === false)
                        return { Confirmado: false };

                    const modal = $('.bootbox-body');

                    const nombreIsla = modal.find('#nombreIsla').val();
                    const estructuraId = parseInt(modal.find('#tipoEstructura').val());
                    const observaciones = modal.find('#observacionesIsla').val();

                    if (!nombreIsla) {
                        bootbox.alert("Por favor nombra la zona");
                        return false;
                    }

                    this.Isla.Confirmado = true;
                    this.Isla.Nombre = nombreIsla;
                    this.Isla.IdEstructura = estructuraId;
                    this.Isla.Observaciones = observaciones;

                    window.crearZona(this.Isla);

                },
                async ConfirmacionActualizarAsync(isla) {

                    var formZona = document.getElementById("formZona").cloneNode(true);
                    formZona.style.display = "block";


                    var respuesta = await MensajeAsync({
                        Titulo: 'Actualizacion',
                        Cuerpo: 'Deseas actualizar los datos de la zona',
                        Boton: [
                            { Etiqueta: 'Actualizar datos', Clase: 'btn-success', Valor: 'Cambio' },
                            { Etiqueta: 'Conservar datos', Clase: 'btn-default', Valor: 'Conservar' },
                            { Etiqueta: 'Eliminar zona', Clase: 'btn-danger', Valor: 'Borrar' },
                        ],
                    });

                    if (respuesta.Valor === 'Cambio') {
                        var cambio = await MensajeAsync({
                            Titulo: 'Editar zona',
                            Cuerpo: formZona,
                            Boton: [
                                { Etiqueta: 'Cancelar', Clase: 'btn-danger', Valor: false },
                                { Etiqueta: 'Confirmar', Clase: 'btn-success', Valor: true }
                            ],
                        });

                        if (cambio.Valor === false)
                            return { Confirmado: false };

                        const modal = $('.bootbox-body');

                        const nombreIsla = modal.find('#nombreIsla').val();
                        const estructuraId = parseInt(modal.find('#tipoEstructura').val());
                        const observaciones = modal.find('#observacionesIsla').val();

                        if (!nombreIsla) {
                            bootbox.alert("Por favor nombra la zona");
                            return false;
                        }

                        this.Isla.Confirmado = true;
                        this.Isla.Nombre = nombreIsla;
                        this.Isla.IdEstructura = estructuraId;
                        this.Isla.Observaciones = observaciones;

                        window.editarZona(this.Isla);
                    } else if (respuesta.Valor === "Conservar") {
                        window.editarZona();
                    } else if (respuesta.Valor === "Borrar") {

                        var borrar = await MensajeAsync({
                            Titulo: "Eliminar zona",
                            Cuerpo: '¿Deseas eliminar esta zona definitivamente?',
                            Boton: [
                                { Etiqueta: 'Cancelar', Clase: 'btn-default', Valor: false },
                                { Etiqueta: 'Eliminar', Clase: 'btn-danger', Valor: true },
                            ],
                        });

                        if (borrar.Valor === false) {
                            return { Confirmado: false };
                        }

                        this.Isla = isla;
                        window.borrarZona(this.Isla);
                    }
                },
                async guardarTodo() {
                    await window.guardarTodoAsync();
                    document.location.href = '@Url.Action("DibujarIsla",new {Id="__id__"})'.replace('__id__', this.Area.Id);
                },
                buscarIconos(filtro, scope = null, pagina = 1, tamPagina = 12) {

                    $.get('/Isla/DameListaIconos', { busqueda: filtro, pagina, tamPagina }, (res) => {
                        if (!res || !res.ok) return;

                        const container = $(scope).find('#iconosContainer').empty();
                        const paginador = $(scope).find('#paginador').empty();

                        res.data.forEach(icono => {
                            container.append(`
                                    <button type="button" class="btn btn-outline-secondary" data-icono="${icono}" title="${icono}">
                                    <i class="fa ${icono}" value="fa ${icono}"></i>
                                    </button>`
                            );
                        });


                        for (let i = 1; i < res.totalPaginas; i++) {
                            const btn = $(`<button class="btn btn-sm ${i === res.paginaActual ? 'btn-primary' : 'btn-light'}">${i}</button>`);
                            btn.on('click', () => this.buscarIconos(filtro, scope, i, tamPagina));
                            paginador.append(btn);
                        }

                        container.off('click').on('click', 'button', function () {
                            const icono = $(this).data('icono');
                            $(scope).find('#iconoSeleccionado').val(icono);

                            container.find('button').removeClass('active btn-success');
                            $(this).addClass('active btn-success');
                        });
                    });
                },
                async agregarEstructura() {
                    var contenido = document.getElementById("formularioEstructuras");
                    var clon = contenido.cloneNode(true);
                    clon.style.display = "block";

                    //var pregunta = await MensajeAsync({
                    //    Titulo: 'Agregar un nuevo tipo de estructura',
                    //    Cuerpo: clon,
                    //    Boton: [
                    //        { Etiqueta: 'Cancelar', Clase: 'btn-danger', Valor: false },
                    //        { Etiqueta: 'Guardar', Clase: 'btn-success', Valor: true },
                    //    ],
                    //});

                    //if (pregunta.Valor === false) {
                    //    return;
                    //}

                    //var modal = $('.bootbox-body');

                    //var descripcion = modal.find(`#descripcionEstructura`).val();
                    //var idEnu = modal.find(`#enuEstructura`).val();
                    //var color = modal.find(`#colorEstructura`).val().replace('#', '');
                    //var icono = clon.querySelector('#iconoSeleccionado').value;

                    //window.agregarEstructura(descripcion, idEnu, color, icono);

                    bootbox.dialog({
                        title: 'Agregar nuevo tipo de estructura',
                        message: clon,
                        buttons: {
                            cancelar: {
                                label: "Cancelar",
                                className: "btn-danger",
                                callback: function () {
                                    return;
                                }
                            },
                            confirm: {
                                label: "Guardar",
                                className: "btn-success",
                                callback: () => {
                                    const modal = $('.bootbox-body');

                                    const descripcion = modal.find(`#descripcionEstructura`).val();
                                    const idEnu = modal.find(`#enuEstructura`).val();
                                    const color = modal.find(`#colorEstructura`).val().replace('#', '');
                                    const icono = clon.querySelector('#iconoSeleccionado').value;

                                    window.agregarEstructura(descripcion, idEnu, color, icono);
                                }
                            }
                        },
                    });

                    setTimeout(() => {
                        var btnBuscar = clon.querySelector("#btnBuscarIconos");
                        var inputFiltro = clon.querySelector("#filtroIcono");

                        if (btnBuscar) {
                            btnBuscar.onclick = () => this.buscarIconos(inputFiltro.value, clon);
                        }
                    }, 100);
                },
            },
            computed: {
                areaSeleccionada() {
                    return this.Area.Nombre ? `Area: ${this.Area.Nombre}` : `Sin seleccion`;
                }
            },
            mounted() {
                window.recibirDatosAActualizar = this.ConfirmacionActualizarAsync;
            },
        });
    </script>
}