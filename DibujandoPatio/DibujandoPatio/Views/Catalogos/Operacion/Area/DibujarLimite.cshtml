@using BT.Patio
@model List<BT.AreaBT>
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
    var patios = ViewBag.Patios as List<PatioBT>;
}

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }

    .sidebar {
        position: fixed;
        top: 0;
        padding: 0px;
        right: -400px;
        width: 400px;
        height: 100vh;
        transition: right 0.3s ease;
        overflow: hidden;
        z-index: 1000;
        background-color: #f4f4f4;
        flex-direction: column;
    }

    .sidebar-header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

    .sidebar-content {
        flex: 1;
        overflow: auto;
        padding: 10px;
    }

    .sidebar.active {
        right: 0;
    }
</style>
<div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; ">
    <div id="lstAreas" class="btn-group" data-toggle="buttons">
        @{
            int i = 0;
        }

        @foreach (var a in areas)
        {
            var activo = (ViewBag.IdAreaSeleccionada != null && ViewBag.IdAreaSeleccionada == a.Id) ? "active" : "";
            var checkedAtrr = (ViewBag.IdAreaSeleccionada != null && ViewBag.IdAreaSeleccionada == a.Id) ? "checked" : "";
            <label class="btn btn-primary @activo">
                <input type="radio"
                       name="area"
                       id="Area_@(a.Id)"
                       data-id="@a.Id"
                       data-nombre="@a.Nombre"
                       autocomplete="off"
                       @checkedAtrr> @a.Nombre
                </label>
                i++;
            }
    </div>
    <button id="guardarBtn" class="btn btn-success pull-right" disabled><i class="glyphicon glyphicon-ok"></i> Guardar</button>
    <button id="btnRedirigir" class="btn btn-warning" disabled><i class="glyphicon glyphicon-pencil"></i>Agregar Zona</button>
    <button id="agregarEnu" class="btn btn-default"><i class="glyphicon glyphicon-plus"></i>Nuevo Enu</button>
    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-resize-full" aria-hidden="true"></i></button>
    <button id="btnDibujar" class="btn btn-success"><i class="glyphicon glyphicon-plus" aria-hidden="true"></i></button>
</div>
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h2>Datos de la isla</h2>
        <button id="cerrarSidebar" class="btn btn-danger pull-right">
            <i class="glyphicon glyphicon-remove"></i>
        </button>
    </div>
    <div id="sidebar-content" class="sidebar-content">
        <table id="tablaDatos"></table>
    </div>
</div>
<div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>

@section scripts{
    @Scripts.Render("~/bundles/konva")
    @Scripts.Render("~/bundles/linq")
    @Styles.Render("~/bundles/jqgridcss")
    @Scripts.Render("~/bundles/jqgrid")
    @Styles.Render("~/bundles/fontawesomecss")

    <script src="~/Scripts/Area/Area.js"></script>
    <script>
        var objSer = {
            Url: {
                Isla: {
                    Index: '@Url.Action("Index", "Isla", new { id = ""})',
                },
                Area: {
                    ObtenerAreaPorId: '@Url.Action("Index", "Area", new { id = "" })',
                },
                Area: {
                    DibujarIsla: '@Url.Action("DibujarIsla", "Area", new {id="__id__"})',
                }
            }
        };
        $(document).ready(function () {
            inicializarArea();
            var inputSeleccionado = $('#lstAreas input[name="area"]:checked');;

            if (inputSeleccionado.length) {
                inputSeleccionado.closest('label').trigger('click');
            }
        });
    </script>
}
