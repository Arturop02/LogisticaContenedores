@using BT.Patio

@model List<BT.Patio.IslaBT>
@{
    ViewBag.Title = "Islas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as List<BT.AreaBT>;
}

<style type="text/css">
    #lstAreas > label.active {
        color: #fff;
        background-color: #449d44;
        border-color: #398439;
    }

    body {
        overflow: hidden;
    }

    #container {
        height: 100vh;
        width: 100vw;
        margin: 0px !important;
    }

    .container {
        margin: 0px !important;
        padding: 0px;
    }

    body > nav.navbar {
        display: none;
    }

    .sidebar {
        position: fixed;
        top: 0;
        padding: 0px;
        right: -400px;
        width: 400px;
        height: 100vh;
        transition: right 0.3s ease;
        overflow: hidden;
        z-index: 1000;
        background-color: #f4f4f4;
        flex-direction: column;
    }

    .sidebar-header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

    .sidebar-content {
        flex: 1;
        overflow: auto;
        padding: 10px;
    }

    .sidebar.active {
        right: 0;
    }
</style>
<div style="width: 100vw; padding: 4px; position: fixed; z-index: 1000; ">
    <div id="lstAreas" class="btn-group" data-toggle="buttons">
        @{
            int i = 0;
        }

        @foreach (var a in areas)
        {
            <label class="btn btn-primary @(i==0 ? "active" : "")">
                <input type="radio"
                       name="area"
                       id="Area_@(a.Id)"
                       data-id="@a.Id"
                       autocomplete="off"
                       @(i == 0 ? "checked" : "")> @a.Nombre
                </label>
                i++;
            }

    </div>
    <button id="guardarBtn" class="btn btn-success pull-right" disabled><i class="glyphicon glyphicon-ok"></i> Guardar</button>
    <button id="crearZona" class="btn btn-success"><i class="glyphicon glyphicon-plus"></i>Agregar</button>
    <button type="button" class="btn btn-warning" id="agregarTipoEstructura"><i class="glyphicon glyphicon-plus"></i>Agregar Tipo Estructura</button>
    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-warning"><i class="glyphicon glyphicon-resize-full" aria-hidden="true"></i></button>
</div>
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h2>Datos de la isla</h2>
        <button id="cerrarSidebar" class="btn btn-danger pull-right">
            <i class="glyphicon glyphicon-remove"></i>
        </button>
    </div>
    <div id="sidebar-content" class="sidebar-content">
        <table id="tablaDatos"></table>
    </div>
</div>
<div id="container" style=" box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>

@section scripts{
    @Scripts.Render("~/bundles/konva")
    @Scripts.Render("~/bundles/linq")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.18/css/bootstrap-select.min.css">
    @Styles.Render("~/bundles/jqgridcss")
    @Scripts.Render("~/bundles/jqgrid")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.18/js/bootstrap-select.min.js"></script>
    @Styles.Render("~/bundles/fontawesome")

    <script src="~/Scripts/Isla/Isla.js"></script>

    <script>
            idAreaSeleccionada = '@ViewBag.IdAreaSeleccionada';
    </script>

    <script>
        $(document).ready(function () {
            inicializarArea();
        });
    </script>

}