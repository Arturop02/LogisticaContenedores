@using BT.Patio
@model List<BT.Patio.PatioBT>
@*@model DibujandoPatio.Models.PatioLayout*@
@{
    ViewBag.Title = "Dibujando Patio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patios = ViewBag.Patios as List<PatioBT>;
}


<div class="mb-3">
    <input type="text" id="nombreInput" placeholder="Ingresa el nombre del patio" />
    @*<label for="escalaInput">Escala:</label>
    <input type="number" id="escalaInput" step="0.1" min="0.1" value="0.5" />*@
</div>

<div class="mb-3">
    <button id="crearPatioBtn" class="btn btn-primary">Iniciar Dibujo</button>
    <button id="guardarBtn" class="btn btn-success" disabled>Guardar</button>
    <button id="btnRedirigir" class="btn btn-primary">Agregar Islas</button>
    <button onclick="Lienzo.RestaurarTamano()" class="btn btn-primary">Tamaño Original</button>
    <button id="eliminarPatioBtn" class="btn btn-danger" disabled>Eliminar Patio</button>
</div>
<br />

<ul class="nav nav-tabs" id="patioTabs" role="tablist">
    @for (int i = 0; i < patios.Count; i++)
    {
        var p = patios[i];
        <li class="nav-item" role="presentation">
            <button class="nav-link btn btn-primary"
                    type="button"
                    role="tab"
                    aria-selected="@(i==0 ? "true" : "false")"
                    data-id="@p.Id"
                    data-escala="@p.Escala">
                @p.Nombre
            </button>
        </li>
    }
</ul>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-12 col-md-10 mx-auto">
            <div id="container" style="width: 100%; height: 80vh; box-sizing: border-box; border: 2px solid #000; overflow:hidden;"></div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            inicializarPatio();
        });
    </script>
    <script src="~/Scripts/Patio/Patio.js"></script>
}